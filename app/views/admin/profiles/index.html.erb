<%= render 'admin/layout' do %>
  <div id="messages">
    <%= render 'admin/profiles/partial/messages' %>
  </div>

  <h2 class="tw-mb-4 tw-text-2xl tw-font-semibold tw-text-gray-900">Registered users</h2>

  <div class="tw-mb-6 tw-rounded-lg tw-border tw-border-gray-200 tw-bg-white tw-p-4 tw-shadow-sm">
    <%= form_with url: admin_profiles_path, method: :get, class: 'tw-flex tw-flex-col tw-gap-3 sm:tw-flex-row sm:tw-items-end' do |form| %>
      <div class="tw-w-full sm:tw-max-w-xl">
        <%= form.label :q, '参加者を検索', class: 'tw-mb-1 tw-block tw-text-sm tw-font-medium tw-text-gray-700' %>
        <%= form.search_field :q,
                              value: @query,
                              placeholder: '氏名・かな・登録メールアドレス',
                              autofocus: true,
                              class: 'tw-block tw-w-full tw-rounded tw-border tw-border-gray-300 tw-px-3 tw-py-2 focus:tw-border-blue-500 focus:tw-ring-1 focus:tw-ring-blue-500' %>
      </div>
      <div class="tw-flex tw-gap-2">
        <%= form.submit '検索', class: 'tw-inline-flex tw-items-center tw-rounded-md tw-border tw-border-transparent tw-bg-blue-600 tw-px-4 tw-py-2 tw-text-sm tw-font-medium tw-text-white tw-shadow-sm hover:tw-bg-blue-700' %>
        <% if @query.present? %>
          <%= link_to 'クリア',
                      admin_profiles_path,
                      class: 'tw-inline-flex tw-items-center tw-rounded-md tw-border tw-border-gray-300 tw-bg-white tw-px-4 tw-py-2 tw-text-sm tw-font-medium tw-text-gray-700 tw-shadow-sm hover:tw-bg-gray-50' %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="tw-mb-6">
    <h2 class="tw-mb-4 tw-text-2xl tw-font-semibold tw-text-gray-900">Export to CSV</h2>
    <%= button_to admin_export_profiles_path, method: :get, class: 'tw-inline-flex tw-items-center tw-rounded-md tw-border tw-border-gray-300 tw-bg-white tw-px-4 tw-py-2 tw-text-sm tw-font-medium tw-text-gray-700 tw-shadow-sm hover:tw-bg-gray-50' do %>
      <%= render 'admin/download_icon' %>
      <span>エクスポート</span>
    <% end %>
  </div>

  <%= turbo_frame_tag 'profiles' do %>
    <div class="admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Name(Kana)</th>
            <th scope="col">登録に用いたEmail</th>
            <th scope="col">参加方法</th>
            <th scope="col">二次元バーコード</th>
            <th scope="col">チェックイン状況</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% @profiles.each do |profile| %>
            <tr>
              <td><%= profile.last_name %> <%= profile.first_name %></td>
              <td><%= profile.last_name_kana %> <%= profile.first_name_kana %></td>
              <td><%= profile.email %></td>
              <td><%= Profile.participations[profile.participation] %></td>
              <td><%= link_to 'QRコードを表示する', admin_entry_sheet_path(id: profile.id) %></td>
              <td><%= render('admin/profiles/partial/check_in_status', profile: profile) %></td>
              <td><%= render('admin/profiles/partial/check_in_button', profile: profile) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="tw-mt-4 tw-flex tw-items-center tw-justify-between">
      <div><%= page_entries_info @profiles %></div>
      <%= paginate @profiles, params: { q: @query.presence } %>
    </div>
  <% end %>
<% end %>
