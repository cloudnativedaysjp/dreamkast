<div class="dk-container">
  <div class="tw-flex tw-justify-center">
    <div class="tw-w-full tw-text-center">
      <h2 class="tw-mt-0 tw-text-black">Sponsors</h2>
      <hr class="divider tw-mx-auto tw-my-4" />

      <% conference.sponsor_types.where(visible: true).each do |sponsor_type| %>
        <h3 class="tw-mt-0 tw-text-black"><%= sponsor_type.name %></h3>
        <hr class="divider tw-mx-auto tw-my-4" />
        <div class="tw-mb-5 tw-flex tw-flex-wrap tw-items-center tw-justify-center">
          <% sponsor_type.sponsors.each do |sponsor| %>
            <% if sponsor.sponsor_attachment_logo_image.present? %>
              <div class="<%= sponsor_logo_class(sponsor_type) %>">
                <a href="<%= sponsor.url %>" target="_blank">
                  <% if sponsor.sponsor_attachment_logo_image.url.present? %>
                    <%= image_tag sponsor.sponsor_attachment_logo_image.url, class: "sponsor-logo" %>
                  <% elsif sponsor.sponsor_attachment_logo_image.file.present? %>
                    <%= image_tag sponsor.sponsor_attachment_logo_image.file_url, class: "sponsor-logo" %>
                  <% end %>
                </a>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="tw-flex tw-justify-end">
    ※ロゴは申込順での掲載となります
  </div>
</div>
