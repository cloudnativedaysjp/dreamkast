<%= turbo_frame_tag "modal" do %>
  <div class="tw-fixed tw-inset-0 tw-z-50 tw-flex tw-items-center tw-justify-center tw-bg-black/40 tw-p-4" data-controller="modal">
    <div class="tw-w-full tw-max-w-lg tw-rounded-lg tw-bg-white tw-shadow-lg">
      <div class="tw-flex tw-items-center tw-justify-between tw-border-b tw-border-gray-200 tw-px-5 tw-py-3">
        <h5 class="tw-m-0 tw-text-lg tw-font-semibold tw-text-gray-900"><%= title%></h5>
        <button type="button" class="tw-rounded tw-p-1 tw-text-gray-500 hover:tw-bg-gray-100" data-action="modal#dismiss" aria-label="Close">×</button>
      </div>
      <div class="tw-px-5 tw-py-4">
        <% flash.each do |message_type, message| %>
          <div class="dk-alert dk-alert-info" role="alert">
            <%= message %>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
