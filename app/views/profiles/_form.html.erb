<%= form_with(url: profile_url, model: @profile, class: "needs-validation cfp-form") do |form| %>
  <% if @profile.errors.any? %>
    <div id="error_explanation" class="dk-alert dk-alert-danger" role="alert">
      <h5 class="tw-font-bold">入力内容にエラーがあります:</h5>
      <ul>
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="cfp-field-group tw-mb-5">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">基本情報</h5>

    <div class="tw-mb-3 tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
        <%= form.label :last_name, class: "dk-label tw-font-semibold" do %>
          姓<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :last_name, required: true, class: "dk-input", placeholder: "雲" %>
      </div>

      <div>
        <%= form.label :first_name, class: "dk-label tw-font-semibold" do %>
          名<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :first_name, required: true, class: "dk-input", placeholder: "太郎" %>
      </div>
    </div>

    <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
        <%= form.label :last_name_kana, class: "dk-label tw-font-semibold" do %>
          姓(カナ)<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :last_name_kana, required: true, class: "dk-input", placeholder: "クラウド" %>
      </div>

      <div>
        <%= form.label :first_name_kana, class: "dk-label tw-font-semibold" do %>
          名(カナ)<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :first_name_kana, required: true, class: "dk-input", placeholder: "タロウ" %>
      </div>
    </div>
  </div>

  <div class="cfp-field-group tw-mb-5">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">所属情報</h5>

    <div class="tw-mb-3">
      <%= form.label :company_name, class: "dk-label tw-font-semibold" do %>
        勤務先名/学校名（前株・後株などはセレクトボックスから選択ください）<span class="dk-required">*</span>
      <% end %>
      <div class="tw-flex tw-flex-col tw-gap-2 md:tw-flex-row">
        <div class="md:tw-w-1/4">
          <%= form.collection_select :company_name_prefix_id, ::FormModels::CompanyNamePrefix.all, :id, :name, {prompt: "法人格を選択"}, {class: "dk-select"} %>
        </div>
        <div class="md:tw-min-w-0 md:tw-flex-1">
          <%= form.text_field :company_name, required: true, class: "dk-input", placeholder: "クラウドネイティブデイズ" %>
        </div>
        <div class="md:tw-w-1/4">
          <%= form.collection_select :company_name_suffix_id, ::FormModels::CompanyNameSuffix.all, :id, :name, {prompt: "法人格を選択"}, {class: "dk-select"} %>
        </div>
      </div>
    </div>

    <div class="tw-mb-3">
      <%= form.label :company_email, class: "dk-label tw-font-semibold" do %>
        勤務先メールアドレス<span class="dk-required">*</span>
      <% end %>
      <%= form.email_field :company_email, required: true, class: "dk-input", placeholder: "mail@example.com" %>
    </div>

    <div data-controller="postal-code">
      <div class="tw-mb-3 tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-3">
        <div>
          <%= form.label :company_postal_code, class: "dk-label tw-font-semibold" do %>
            勤務先住所: 郵便番号<span class="dk-required">*</span>
          <% end %>
          <%= form.text_field :company_postal_code,
              required: true,
              class: "dk-input",
              minlength: "7",
              maxlength: "8",
              pattern: "(\\d{7}|\\d{3}-\\d{4})",
              placeholder: "1000001",
              autocomplete: "postal-code",
              data: {
                postal_code_target: "postalCode",
                action: "input->postal-code#search"
              } %>

          <div class="tw-mt-2 tw-hidden" data-postal-code-target="loading">
            <small class="tw-text-gray-500">住所を検索中...</small>
          </div>

          <div class="tw-mt-2 tw-hidden tw-text-sm tw-text-red-600" data-postal-code-target="error" role="alert"></div>
        </div>

        <div>
          <%= form.label :company_address_level1, class: "dk-label tw-font-semibold" do %>
            都道府県<span class="dk-required">*</span>
          <% end %>
          <%= form.collection_select :company_address_level1,
              CompanyAddressLevel1.all,
              :name,
              :name,
              {prompt: ""},
              {
                required: true,
                class: "dk-select",
                autocomplete: "address-level1",
                data: { postal_code_target: "prefecture" }
              } %>
        </div>

        <div>
          <%= form.label :company_address_level2, class: "dk-label tw-font-semibold" do %>
            市区町村<span class="dk-required">*</span>
          <% end %>
          <%= form.text_field :company_address_level2,
              required: true,
              class: "dk-input",
              placeholder: "港区",
              autocomplete: "address-level2",
              data: { postal_code_target: "city" } %>
        </div>
      </div>

      <div class="tw-mb-3 tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
        <div>
          <%= form.label :company_address_line1, class: "dk-label tw-font-semibold" do %>
            町名・番地<span class="dk-required">*</span>
          <% end %>
          <%= form.text_field :company_address_line1,
              required: true,
              class: "dk-input",
              placeholder: "赤坂1−2−3",
              autocomplete: "address-line1",
              data: { postal_code_target: "addressLine1" } %>
        </div>
        <div>
          <%= form.label :company_address_line2, "建物名など", class: "dk-label tw-font-semibold" %>
          <%= form.text_field :company_address_line2,
              required: false,
              class: "dk-input",
              autocomplete: "address-line2" %>
        </div>
      </div>
    </div>

    <div class="tw-mb-3 tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
        <%= form.label :company_tel, class: "dk-label tw-font-semibold" do %>
          勤務先電話番号<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :company_tel, required: true, class: "dk-input", placeholder: "0300000000", pattern: "[\\d+-]*" %>
      </div>
      <div>
        <%= form.label :company_fax, "勤務先FAX番号", class: "dk-label tw-font-semibold" %>
        <%= form.text_field :company_fax, required: false, class: "dk-input", placeholder: "0300000000", pattern: "[\\d+-]*" %>
      </div>
    </div>

    <div class="tw-mb-3">
      <%= form.label :department, class: "dk-label tw-font-semibold" do %>
        勤務先部署･所属 / 学部･学科･学年<span class="dk-required">*</span>
      <% end %>
      <%= form.text_field :department, required: true, class: "dk-input", placeholder: "クラウド開発部門" %>
    </div>

    <div>
      <%= form.label :position, class: "dk-label tw-font-semibold" do %>
        勤務先役職<span class="dk-required">*</span>
      <% end %>
      <%= form.text_field :position, required: true, class: "dk-input", placeholder: "一般 / 管理職 / CTO など" %>
    </div>
  </div>

  <div class="cfp-field-group tw-mb-5">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">属性アンケート</h5>

    <div class="tw-mb-3 tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
        <%= form.label :number_of_employee_id, class: "dk-label tw-font-semibold" do %>
          従業員数<span class="dk-required">*</span>
        <% end %>
        <%= form.collection_select :number_of_employee_id, ::FormModels::NumberOfEmployee.all, :id, :name, {prompt: ""}, {required: true, class: "dk-select", autocomplete: "number-of-employee-id"} %>
      </div>
      <div>
        <%= form.label :occupation_id, "職種", class: "dk-label tw-font-semibold" %>
        <%= form.collection_select :occupation_id, ::FormModels::Occupation.all, :id, :name, {prompt: "", disabled: ::FormModels::Occupation.all.map{|i| i.id if i.disabled}.compact}, {required: true, class: "dk-select", autocomplete: "occupation_id"} %>
      </div>
    </div>

    <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
         <%= form.label :industry_id, "業種", class: "dk-label tw-font-semibold" %>
         <%= form.grouped_collection_select(
           :industry_id,
           ::FormModels::Industry.all,
           :child,
           :name,
           :id, :name,
           {prompt: "選択してください"},
           {class: "dk-select", autocomplete: "industry_id"}) %>
      </div>
      <div>
        <%= form.label :annual_sales_id, "年商規模", class: "dk-label tw-font-semibold" %>
        <%= form.collection_select :annual_sales_id, ::FormModels::AnnualSales.all, :id, :name, {prompt: ""}, {class: "dk-select", autocomplete: "annual-sales-id"} %>
      </div>
    </div>
  </div>

  <div class="cfp-field-group tw-mb-5" id="participation">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">参加方法</h5>
    <div class="tw-space-y-2 tw-px-1">
      <div class="tw-flex tw-items-center">
        <%= form.radio_button :participation, :online, { class: "dk-radio", id: "participation_online", required: true, checked: @profile.participation == 'online' || (@profile.participation.blank? && @conference.reach_capacity?) } %>
        <%= form.label :online, "リモート参加", { for: "participation_online", class: "dk-check-label reached_capacity"} %>
      </div>
      <div class="tw-flex tw-items-center">
        <%= form.radio_button :participation, :offline, { class: "dk-radio", id: "participation_offline" , disabled: @conference.reach_capacity?, required: true, checked: !@conference.reach_capacity? && (@profile.participation.blank? || @profile.participation == 'offline') } %>
        <% if @conference.reach_capacity? %>
          <%= form.label :offline, "現地参加", { for: "participation_offline" , class: "dk-check-label reached_capacity"} %>
        <% else %>
          <%= form.label :offline, "現地参加", { for: "participation_offline", class: "dk-check-label tw-font-semibold" } %>
        <% end %>
      </div>
      <% if @conference.reach_capacity? %>
        <span class="dk-required tw-block tw-text-xs">現地参加は定員に達したためお申込みいただけません</span>
      <% end %>
    </div>
  </div>

  <% FormItem.where(conference_id: @conference.id).each do |form_item| %>
    <div class="cfp-field-group tw-mb-4">
      <%= label_tag "form_item[#{form_item.attr}]", form_item.name, class: "dk-label tw-font-semibold" %>
      <%
        form_value = @profile.form_values.find_by(form_item_id: form_item.id)
        value = form_value ? form_value.value : nil
      %>
      <%= text_field_tag "form_item[#{form_item.attr}]", value, required: false, class: "dk-input", placeholder: "" %>
    </div>
  <% end %>

  <% if action_name == "new" %>
  <div class="dk-card tw-mb-4 tw-p-4">
      <div class="prose">
          <%= markdown @conference.privacy_policy %>
      </div>

      <div class="cfp-checkbox-card tw-mt-3 tw-flex tw-items-start tw-gap-2 tw-border tw-border-gray-200 tw-p-3">
        <%= form.check_box :agreement, {required: true, class: "dk-checkbox"}, true, false %>
        <label class="dk-check-label tw-font-semibold" for="agreement">個人情報の取り扱いについて同意する <span class="tw-block tw-text-xs tw-font-normal tw-text-gray-500">ご同意いただけない場合は本セミナーを受講いただくことは出来ません。</span></label>
      </div>
  </div>
  <% end %>

  <div class="cfp-submit tw-py-4 tw-text-center">
    <%= form.submit submit_button_label, class: "dk-btn-primary tw-px-8 tw-py-3 tw-text-lg" %>
  </div>
<% end %>
