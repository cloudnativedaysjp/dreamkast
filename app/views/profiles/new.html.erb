<div class="japanese-modern-theme">
<div class="dk-container">
  <div class="tw-flex tw-justify-center">
    <div class="speaker-dashboard-form cfp-form tw-my-3 tw-w-full tw-py-4 tw-px-0 md:tw-px-8 lg:tw-w-2/3">
      <% flash.each do |message_type, message| %>
        <div class="dk-alert <%= dk_alert_class(message_type) %>" role="alert">
          <%= message %>
        </div>
      <% end %>
      <h2 class="cfp-dashboard-title tw-mb-2 tw-text-center">参加登録フォーム</h2>
      <p class="tw-mb-5 tw-text-center tw-text-gray-500"><%= @conference.name %></p>
      <% if logged_in? %>
        <%= render 'form', profile: @profile, submit_button_label: "個人情報保護方針に同意して参加登録" %>
      <% else %>
        <div class="tw-my-4 tw-w-full tw-text-center">
          <%= button_to 'ログイン / サインアップ', '/auth/auth0', {method: :post, class: "dk-btn-primary tw-mb-4 tw-px-8 tw-py-3 tw-text-lg" } %>
          <% if @conference.abbr == 'cnk' %>
            <%= label_tag 'entry', '参加登録するにはクラウドネイティブ会議へのサインアップが必要です', class: "tw-text-gray-500" %>
          <% else %>
            <%= label_tag 'entry', '参加登録するにはCloudNative Daysへのサインアップが必要です', class: "tw-text-gray-500" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>
