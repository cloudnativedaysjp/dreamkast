<%= form_with(url: public_profile_path, model: @public_profile, class: "needs-validation cfp-form") do |form| %>
  <% if @public_profile.errors.any? %>
    <div id="error_explanation" class="dk-alert dk-alert-danger" role="alert">
      <h5 class="tw-font-bold">入力内容にエラーがあります:</h5>
      <ul>
        <% @public_profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="dk-alert dk-alert-info tw-mb-4" role="alert">
    公開プロフィールとは、あなたのニックネームやSNSアカウントを公開できる機能です（オプション）
  </div>

  <div class="cfp-field-group tw-mb-4">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">基本情報</h5>

    <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
        <%= form.label :nickname, class: "dk-label tw-font-semibold" do %>
          ニックネーム<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :nickname, required: true, class: "dk-input", placeholder: "雲太郎", id: "public_profile_nickname" %>
        <div class="dk-hint">参加者一覧に表示される名前</div>
      </div>
    </div>
  </div>

  <div class="cfp-field-group tw-mb-4">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">SNS・連絡先</h5>

    <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
      <div>
        <label class="dk-label tw-font-semibold">X(Twitter) ID</label>
        <div class="dk-input-group">
          <span class="dk-input-prefix">@</span>
          <%= form.text_field :twitter_id, class: "dk-input", placeholder: "cloudnativedays", id: "public_profile_twitter_id" %>
        </div>
        <div class="dk-hint">@は不要です</div>
      </div>

      <div>
        <label class="dk-label tw-font-semibold">GitHub ID</label>
        <div class="dk-input-group">
          <span class="dk-input-prefix">github.com/</span>
          <%= form.text_field :github_id, class: "dk-input", placeholder: "cloudnativedaysjp", id: "public_profile_github_id" %>
        </div>
      </div>
    </div>
  </div>

  <div class="cfp-field-group tw-mb-4">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">プロフィール写真</h5>

    <div class="tw-grid tw-grid-cols-1 tw-gap-4 md:tw-grid-cols-12">
      <div class="md:tw-col-span-8">
        <div class="cfp-upload-area tw-p-4 tw-text-center" data-controller="crop-upload">
          <p class="tw-mb-2 tw-font-semibold">参加者アイコンをアップロード</p>
          <p class="tw-mb-3 tw-text-sm tw-text-gray-500">クリックまたはドラッグ&ドロップ</p>
          <%= form.text_field :avatar,
                              type: :file,
                              id: "avatar_upload",
                              "data-crop-upload-target": "fileInput",
                              class: "dk-input" %>
          <%= form.text_field :avatar,
                              type: :hidden,
                              error_handler: false,
                              class: "upload-data",
                              value: @public_profile.nil? ? "" : @public_profile.cached_avatar_data %>
        </div>
      </div>

      <div class="md:tw-col-span-4">
        <div class="cfp-image-preview tw-text-center">
          <div class="image-preview tw-p-2" style="min-height: 200px;">
            <% has_avatar = @public_profile.present? && (@public_profile.avatar.present? || @public_profile.avatar_url.present?) %>
            <% avatar_url = has_avatar ? (@public_profile.avatar_url(:large) || @public_profile.avatar_url) : nil %>
            <img src="<%= avatar_url || '' %>"
                 class="tw-h-auto tw-max-h-[250px] tw-max-w-full"
                 style="object-fit: cover;<%= ' display: none;' unless avatar_url.present? %>"
                 alt="プロフィール写真プレビュー">
            <div class="image-placeholder tw-flex tw-h-full tw-items-center tw-justify-center tw-text-gray-500" style="min-height: 180px;<%= ' display: none;' if avatar_url.present? %>">
              <div class="tw-text-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="tw-mb-2 tw-opacity-25" viewBox="0 0 16 16">
                  <path d="M1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5h-13zm13 1v8.293l-2.146-2.147a.5.5 0 0 0-.708 0L9 10.793 6.854 8.646a.5.5 0 0 0-.708 0L2.5 12.293V2h12zm-10.5 3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0z"/>
                </svg>
                <p class="tw-mb-0 tw-text-sm">未選択</p>
              </div>
            </div>
          </div>
          <p class="tw-mb-0 tw-mt-2 tw-text-sm tw-text-gray-500">プレビュー</p>
        </div>
      </div>
    </div>
  </div>

  <div class="cfp-field-group tw-mb-4">
    <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">公開設定</h5>

    <div class="cfp-checkbox-card tw-border tw-border-gray-200 tw-p-3">
      <%= form.check_box :is_public, class: "dk-checkbox" %>
      <%= form.label :is_public, class: "dk-check-label" do %>
        <%= link_to('参加者一覧ページ', "/#{@conference.abbr}/attendees", class: "tw-text-gray-900 tw-underline") %>に上記のプロフィールを公開する
      <% end %>
    </div>
  </div>

  <div class="cfp-submit tw-py-4 tw-text-center">
    <div class="tw-mb-3">
      <%= form.submit submit_button_label, class: "dk-btn-primary tw-px-8 tw-py-3 tw-text-lg" %>
    </div>
    <div>
      <%= link_to 'スキップ', dashboard_path, class: "tw-text-sm tw-text-gray-500 tw-underline" %>
    </div>
  </div>
<% end %>
