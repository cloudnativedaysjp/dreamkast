<div class="japanese-modern-theme">
<div class="dk-container">
  <div class="tw-flex tw-justify-center">
    <div class="speaker-dashboard-form cfp-form tw-my-3 tw-w-full tw-py-4 tw-px-0 md:tw-px-8 lg:tw-w-2/3">
      <% flash.each do |_key, _value| %>
        <p id="notice" class="dk-alert dk-alert-success" role="alert"><%= flash[:notice] %></p>
      <% end %>
      <h2 class="cfp-dashboard-title tw-mb-2 tw-text-center">プロフィール更新</h2>
      <p class="tw-mb-5 tw-text-center tw-text-gray-500"><%= @conference.name %></p>

      <%= render 'form', submit_button_label: "プロフィールを更新する" %>
    </div>
  </div>
</div>
</div>
