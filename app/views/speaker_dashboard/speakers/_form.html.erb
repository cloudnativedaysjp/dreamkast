<%= form_with(model: @speaker_form, url: speaker_url, method: (action_name == 'edit' ? :patch : :post), local: true, data: { turbo: false }, class: 'cfp-form') do |form| %>

  <div class="cfp-progress tw-mb-5">
    <div class="tw-flex tw-items-center tw-justify-center">
      <div class="cfp-step active">
        <div class="cfp-step-icon">
          <span class="cfp-step-number">1</span>
        </div>
        <span class="cfp-step-label">登壇者情報</span>
      </div>
      <div class="cfp-step-connector"></div>
      <div class="cfp-step">
        <div class="cfp-step-icon">
          <span class="cfp-step-number">2</span>
        </div>
        <span class="cfp-step-label">セッション情報</span>
      </div>
      <div class="cfp-step-connector"></div>
      <div class="cfp-step">
        <div class="cfp-step-icon">
          <span class="cfp-step-number">3</span>
        </div>
        <span class="cfp-step-label">確認・送信</span>
      </div>
    </div>
  </div>

  <section class="speaker-information tw-mb-5" id="speaker">
    <div class="dk-card tw-border-0">
      <div class="tw-bg-cndt-navy tw-px-4 tw-py-3 tw-text-white">
        <h3 class="tw-mb-0">
          <span class="cfp-section-number tw-mr-2">1.</span>登壇者情報
        </h3>
      </div>
      <div class="tw-p-4">
        <%= render('speaker_dashboard/speakers/form_speaker', form: form) %>
      </div>
    </div>
  </section>

  <section class="speaker-information tw-mb-5" id="sessions">
    <div class="dk-card tw-border-0">
      <div class="tw-bg-cndt-navy tw-px-4 tw-py-3 tw-text-white">
        <h3 class="tw-mb-0">
          <span class="cfp-section-number tw-mr-2">2.</span>セッション情報
        </h3>
      </div>
      <div class="tw-p-4">
        <div class="dk-alert dk-alert-info tw-mb-4" role="alert">
          <%= link_to 'CFP要項を確認する', 'https://cloudnativedays.jp/cndw2026/cfp/', target: :_blank, class: 'tw-font-semibold tw-underline' %>
          <span class="tw-ml-1 tw-text-sm">（別タブで開きます）</span>
        </div>

        <div class="cfp-rating-guide tw-mb-4 tw-p-3">
          <p class="tw-mb-2 tw-font-semibold">採択への影響度について</p>
          <div class="tw-flex tw-flex-wrap tw-gap-3 tw-text-sm">
            <span class="tw-rounded tw-bg-yellow-400 tw-px-3 tw-py-2 tw-text-gray-900">★★★ 非常に重要</span>
            <span class="tw-rounded tw-bg-gray-500 tw-px-3 tw-py-2 tw-text-white">★★ 重要</span>
            <span class="tw-rounded tw-border tw-border-gray-300 tw-bg-gray-50 tw-px-3 tw-py-2 tw-text-gray-800">★ 参考</span>
          </div>
        </div>

        <div class="talk-fields">
          <% @speaker_form.talks.each_with_index do |talk_obj, index| %>
            <%= form.fields_for :talks_attributes, talk_obj, index: index do |talk| %>
              <%= render 'speaker_dashboard/speakers/talk_fields', :f => talk, :conference => @conference, :form_index => index %>
            <% end %>
          <% end %>
        </div>

        <% if @conference.speaker_entry_enabled? || @sponsor || admin? %>
          <% if action_name == "new" || @speaker_form.talks.size < 3 %>
            <div class="cfp-add-session tw-mt-4 tw-p-4 tw-text-center">
              <p class="tw-mb-3 tw-text-gray-500">追加ボタンを押すとセッションを最大3件まで登録できます</p>
              <p class="tw-mb-3 tw-text-sm tw-text-gray-500">エントリー後にダッシュボードから更新可能です</p>
              <%= link_to_add_talk_fields "＋ セッションを追加する", form, :talks, class: 'add-talk dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg' %>
            </div>
          <% else %>
            <div class="tw-hidden">
              <%= link_to_add_talk_fields "セッションを追加する", form, :talks, class: 'add-talk dk-btn-primary' %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="privacy tw-mb-5">
    <div class="dk-card tw-border-0">
      <div class="tw-bg-gray-800 tw-px-4 tw-py-3 tw-text-white">
        <h3 class="tw-mb-0">
          <span class="cfp-section-number tw-mr-2">3.</span>プライバシーポリシー
        </h3>
      </div>
      <div class="tw-p-4">
        <%= form.hidden_field :conference_id, value: @conference.id %>
        <div class="privacy-content tw-p-3" style="max-height: 300px; overflow-y: auto;">
          <%= markdown @conference.privacy_policy_for_speaker %>
        </div>
      </div>
    </div>
  </section>

  <div class="cfp-submit tw-py-4 tw-text-center">
    <div class="tw-mx-auto tw-max-w-md">
      <%= form.submit class: "dk-btn-primary tw-w-full tw-py-3 tw-text-lg tw-font-bold" %>
    </div>
    <p class="tw-mt-3 tw-text-sm tw-text-gray-500">送信後もダッシュボードから内容を編集できます</p>
  </div>
<% end %>
