<div class="cfp-field-group tw-mb-4">
  <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">基本情報</h5>

  <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
    <div>
      <%= form.label :name, class: 'dk-label tw-font-semibold' do %>
        講演者氏名（英語表記）<span class="dk-required">*</span>
      <% end %>
      <%= form.text_field :name, class: "dk-input", required: true, placeholder: 'Taro Cloud', id: 'speaker_name' %>
      <div class="dk-hint">Your Name (e.g., Taro Cloud)</div>
    </div>

    <div>
      <%= form.label :name_mother_tongue, class: 'dk-label tw-font-semibold' do %>
        講演者氏名（漢字）<span class="dk-required">*</span>
      <% end %>
      <%= form.text_field :name_mother_tongue, class: "dk-input", required: true, placeholder: 'クラウド 太郎', id: 'speaker_name_mother_tongue' %>
      <div class="dk-hint">Name "kanji" - If you do not have a Kanji name, please set "N/A"</div>
    </div>
  </div>
</div>

<div class="cfp-field-group tw-mb-4">
  <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">所属情報</h5>

  <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
    <div>
      <%= form.label :company, class: 'dk-label tw-font-semibold' do %>
        会社名/所属団体名<span class="dk-required">*</span>
        <span class="tw-ml-1 tw-rounded tw-bg-gray-500 tw-px-2 tw-py-0.5 tw-text-xs tw-text-white">★</span>
      <% end %>
      <%= form.text_field :company, class: "dk-input", required: true, placeholder: 'クラウドネイティブデイズ株式会社', id: 'speaker_company' %>
      <div class="dk-hint">Company/Organizations</div>
    </div>

    <div>
      <%= form.label :job_title, class: 'dk-label tw-font-semibold' do %>
        肩書き<span class="dk-required">*</span>
      <% end %>
      <%= form.text_field :job_title, class: "dk-input", required: true, placeholder: '凄腕エンジニア', id: 'speaker_job_title' %>
      <div class="dk-hint">Job Title</div>
    </div>
  </div>
</div>

<div class="cfp-field-group tw-mb-4">
  <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">プロフィール</h5>

  <div class="tw-mb-3">
    <%= form.label :profile, class: 'dk-label tw-font-semibold' do %>
      講演者プロフィール<span class="dk-required">*</span>
    <% end %>
    <%= form.text_area :profile, class: "dk-textarea", required: true, rows: 5, id: 'speaker_profile', placeholder: 'あなたの経歴や専門分野について記載してください...' %>
    <div class="dk-hint tw-flex tw-justify-between">
      <span>Biography - 最大300文字 (Maximum 300 letters)</span>
      <span class="tw-text-gray-500" id="profile-char-count">0 / 300</span>
    </div>
  </div>

  <div class="tw-mb-3">
    <%= form.label :additional_documents, class: 'dk-label tw-font-semibold' do %>
      過去の登壇実績が分かるスライド等
      <span class="tw-ml-1 tw-rounded tw-bg-gray-500 tw-px-2 tw-py-0.5 tw-text-xs tw-text-white">★</span>
    <% end %>
    <%= form.text_area :additional_documents, class: "dk-textarea", required: false, rows: 3, id: 'speaker_additional_documents', placeholder: "https://speakerdeck.com/your-slides\nhttps://www.slideshare.net/your-presentation" %>
    <div class="dk-hint">Published Slides, etc. - 複数ある場合は改行で区切ってください</div>
  </div>
</div>

<div class="cfp-field-group tw-mb-4">
  <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">SNS・連絡先</h5>

  <div class="tw-grid tw-grid-cols-1 tw-gap-3 md:tw-grid-cols-2">
    <div>
      <label class="dk-label tw-font-semibold">X(Twitter) ID</label>
      <div class="dk-input-group">
        <span class="dk-input-prefix">@</span>
        <%= form.text_field :twitter_id, class: "dk-input", placeholder: 'cloudnativedays', id: 'speaker_twitter_id' %>
      </div>
      <div class="dk-hint">@は不要です</div>
    </div>

    <div>
      <label class="dk-label tw-font-semibold">GitHub ID</label>
      <div class="dk-input-group">
        <span class="dk-input-prefix">github.com/</span>
        <%= form.text_field :github_id, class: "dk-input", placeholder: 'cloudnativedaysjp', id: 'speaker_github_id' %>
      </div>
    </div>
  </div>
</div>

<div class="cfp-field-group tw-mb-4">
  <h5 class="cfp-field-group-title tw-mb-3 tw-border-b tw-border-gray-200 tw-pb-2">プロフィール写真</h5>

  <div class="tw-grid tw-grid-cols-1 tw-gap-4 md:tw-grid-cols-12">
    <div class="md:tw-col-span-8">
      <div class="cfp-upload-area tw-p-4 tw-text-center" data-controller="crop-upload">
        <p class="tw-mb-2 tw-font-semibold">講演者写真をアップロード</p>
        <p class="tw-mb-3 tw-text-sm tw-text-gray-500">Photographs - クリックまたはドラッグ&ドロップ</p>
        <%= form.text_field :avatar,
                            type: :file,
                            id: "avatar_upload",
                            "data-crop-upload-target": "fileInput",
                            class: "dk-input" %>
        <%= form.text_field :avatar,
                            type: :hidden,
                            error_handler: false,
                            class: "upload-data",
                            value: @speaker.nil? ? "" : @speaker.cached_avatar_data %>
      </div>
    </div>

    <div class="md:tw-col-span-4">
      <div class="cfp-image-preview tw-text-center">
        <div class="image-preview tw-p-2" style="min-height: 200px;">
          <% has_avatar = @speaker.present? && (@speaker.avatar.present? || @speaker.avatar_url.present?) %>
          <% avatar_url = has_avatar ? (@speaker.avatar_url(:large) || @speaker.avatar_url) : nil %>
          <img src="<%= avatar_url || '' %>"
               class="tw-h-auto tw-max-h-[250px] tw-max-w-full"
               style="object-fit: cover;<%= ' display: none;' unless avatar_url.present? %>"
               alt="プロフィール写真プレビュー">
          <div class="image-placeholder tw-flex tw-h-full tw-items-center tw-justify-center tw-text-gray-500" style="min-height: 180px;<%= ' display: none;' if avatar_url.present? %>">
            <div class="tw-text-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="tw-mb-2 tw-opacity-25" viewBox="0 0 16 16">
                <path d="M1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5h-13zm13 1v8.293l-2.146-2.147a.5.5 0 0 0-.708 0L9 10.793 6.854 8.646a.5.5 0 0 0-.708 0L2.5 12.293V2h12zm-10.5 3a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0z"/>
              </svg>
              <p class="tw-mb-0 tw-text-sm">未選択</p>
            </div>
          </div>
        </div>
        <p class="tw-mb-0 tw-mt-2 tw-text-sm tw-text-gray-500">プレビュー</p>
      </div>
    </div>
  </div>
</div>
