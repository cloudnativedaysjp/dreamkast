<div class="dk-container speaker-dashboard-form cfp-form tw-py-4">
  <div class="tw-flex tw-justify-center">
    <div class="tw-w-full lg:tw-w-5/6">
      <div class="tw-mb-5 tw-text-center">
        <h1 class="cfp-dashboard-title tw-mb-2">プロポーザル編集</h1>
        <p class="tw-text-gray-500">Edit Proposal</p>
      </div>

      <%= render 'form', speaker: @speaker %>

      <div class="tw-mt-4 tw-text-center">
        <%= link_to speaker_dashboard_path, class: "dk-btn-secondary tw-px-6" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="tw-mr-1" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
          </svg>
          ダッシュボードに戻る
        <% end %>
      </div>
    </div>
  </div>
</div>
