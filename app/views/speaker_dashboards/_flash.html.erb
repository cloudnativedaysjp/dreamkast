<% if notice %>
  <div class="dk-alert dk-alert-success tw-mb-2" data-controller="toast" role="status">
    <strong class="tw-block">成功</strong>
    <div><%= notice %></div>
  </div>
<% end %>

<% if alert %>
  <div class="dk-alert dk-alert-danger tw-mb-2" data-controller="toast" role="alert">
    <strong class="tw-block">エラー</strong>
    <div><%= alert %></div>
  </div>
<% end %>
