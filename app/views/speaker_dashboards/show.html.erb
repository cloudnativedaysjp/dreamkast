<div class="dk-container speaker-dashboard-form cfp-form tw-py-4">
  <%= render 'speaker_dashboards/navigator' %>
  <div class="tw-w-full">
    <h1 class="entry tw-py-3 tw-text-center">登壇者ダッシュボード</h1>
    <div class="speaker-dashboard-form">

  <% flash.each do |message_type, message| %>
    <div class="dk-alert <%= dk_alert_class(message_type) %>" role="alert">
      <%= message %>
    </div>
  <% end %>

  <% unless @speaker.present? %>
    <div class="tw-my-5 tw-text-center">
      <div class="cfp-entry-card tw-rounded tw-border tw-border-gray-200 tw-bg-white tw-p-10 tw-shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="tw-mb-3 tw-text-gray-400 tw-opacity-50" viewBox="0 0 16 16">
          <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
        </svg>
        <% if @conference&.speaker_entry_enabled? %>
        <h4 class="tw-mb-3">まだエントリーしていません</h4>
          <p class="tw-mb-4 tw-text-gray-500">プロポーザルを提出するには、まずエントリーを完了してください。</p>
          <%= link_to 'エントリーする', speakers_entry_path, class: "dk-btn-primary tw-px-8 tw-py-3 tw-text-lg" %>
        <% else %>
          <p class="tw-mb-4 tw-text-gray-500">現在、新規エントリー受付は終了しています。</p>
        <% end %>
        <p class="tw-mb-4 tw-text-gray-500">スピーカーダッシュボードを確認するにはログインしてください。</p>
        <%= link_to 'ログインする', auth_login_path(origin: request.fullpath), class: "dk-btn-primary tw-px-8 tw-py-3 tw-text-lg" unless logged_in? %>
      </div>
    </div>
  <% else %>
      <div class="tw-my-4 tw-w-full" id="speaker_notice">
        <%= render 'tracks/speaker_announcements',
            speaker_announcements: @speaker_announcements,
            unanswered_questions_count: @unanswered_questions&.count || 0,
            event_name: @conference&.abbr || event_name %>
      </div>

      <div class="tw-grid tw-grid-cols-1 tw-gap-4 md:tw-grid-cols-2">
        <div>
          <%= render 'speaker_dashboard/speakers/speaker_info', speaker: @speaker %>
        </div>
        <div>
          <%= render 'speaker_dashboard/speakers/talk_list', conference: @conference, speaker: @speaker %>
        </div>
      </div>

    <% end %>
    </div>
  </div>
</div>
