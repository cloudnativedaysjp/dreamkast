<% provide(:title, 'プロポーザル募集') %>

<div class="dk-container speaker-dashboard-form tw-py-4" id="speaker-landing">
  <div class="tw-my-4">
    <h2 class="tw-mb-3 tw-text-center tw-text-2xl tw-font-semibold">共同スピーカーとして招待された方へ</h2>
    <p>本ページは共同スピーカーとしての招待メールを受け取った方向けのページです。</p>
    <p>下記の概要・Q&Aを確認していただき、問題なければ「エントリーする！」ボタンをクリックしてください。</p>
    <p>その後、登壇者情報の入力フォームに遷移しますので、入力することで共同スピーカーとして登録されます。</p>
  </div>

  <%= render 'speaker_dashboard/speakers/guidance_section_1' %>

  <div class="tw-my-4 tw-text-center">
    <% if logged_in? %>
      <%= button_to 'エントリーする！', new_speaker_invitation_accept_path, {params: {token: @speaker_invitation.token}, method: :get, class: "dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg" } %>
    <% else %>
      <%= button_to 'エントリーする！', '/auth/auth0', {method: :post, class: "dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg" } %>
    <% end %>
    <%= label_tag 'entry', 'エントリーにはCloudNative Daysへのサインアップが必要です', class: 'dk-hint tw-mt-2 tw-block' %>
  </div>

  <%= render 'speaker_dashboard/speakers/guidance_section_2' %>

  <div class="tw-my-4 tw-text-center">
    <% if logged_in? %>
      <%= button_to 'エントリーする！', new_speaker_invitation_accept_path, {params: {token: @speaker_invitation.token}, method: :get, class: "dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg" } %>
    <% else %>
      <%= button_to 'エントリーする！', '/auth/auth0', {method: :post, class: "dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg" } %>
    <% end %>
    <%= label_tag 'entry', 'エントリーにはCloudNative Daysへのサインアップが必要です', class: 'dk-hint tw-mt-2 tw-block' %>
  </div>
</div>
