<div class="dk-container speaker-dashboard-form tw-py-4">
  <div class="tw-mx-auto tw-w-full tw-max-w-2xl">
    <% flash.each do |key, value| %>
      <div class="dk-alert dk-alert-danger" role="alert"><%= flash[:alert] %></div>
    <% end %>
    <h1 class="entry tw-mb-6 tw-text-center tw-text-2xl tw-font-semibold">共同スピーカーに招待メールを送信する</h1>

    <%= form_with(model: @speaker_invitation) do |form| %>
      <div class="tw-mb-4">
        <%= form.label :email, class: 'dk-label' %>
        <%= form.email_field :email, class: "dk-input", required: true %>
      </div>

      <%= form.hidden_field :talk_id, value: @talk.id %>

      <div class="tw-text-center">
        <%= form.submit "招待メールを送信する", class: "dk-btn-primary tw-w-full tw-py-3", data: { turbo_confirm: '本当に公開しますか？' } %>
      </div>
    <% end %>
  </div>
</div>
