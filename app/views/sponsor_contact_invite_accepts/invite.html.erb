<% provide(:title, 'スポンサー担当者招待') %>

<div class="dk-container speaker-dashboard-form tw-py-4" id="speaker-landing">
  <div class="tw-my-4">
    <h2 class="tw-mb-3 tw-text-center tw-text-2xl tw-font-semibold">スポンサー担当者として招待された方へ</h2>
    <p>本ページはスポンサー担当者としての招待メールを受け取った方向けのページです。</p>
  </div>

  <div class="tw-my-4 tw-text-center">
    <% if logged_in? %>
      <%= button_to 'スポンサー担当者として登録する', new_sponsor_contact_invite_accept_path, {params: {token: @sponsor_contact_invite.token}, method: :get, class: "dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg" } %>
    <% else %>
      <%= button_to 'スポンサー担当者として登録する', '/auth/auth0', {method: :post, class: "dk-btn-secondary tw-px-6 tw-py-3 tw-text-lg" } %>
    <% end %>
    <% if @conference.abbr == 'cnk' %>
      <%= label_tag 'entry', 'エントリーにはクラウドネイティブ会議へのサインアップが必要です', class: 'dk-hint tw-mt-2 tw-block' %>
    <% else %>
      <%= label_tag 'entry', 'エントリーにはCloudNative Daysへのサインアップが必要です', class: 'dk-hint tw-mt-2 tw-block' %>
    <% end %>
  </div>
</div>
