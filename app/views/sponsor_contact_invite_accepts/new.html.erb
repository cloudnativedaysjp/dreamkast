<div class="dk-container speaker-dashboard-form tw-py-4">
  <div class="tw-mx-auto tw-w-full tw-max-w-2xl">
    <h1 class="entry tw-mb-6 tw-text-center tw-text-2xl tw-font-semibold">スポンサー担当者として登録する</h1>
    <% flash.each do |type, message| %>
      <div class="dk-alert dk-alert-warning" role="alert">
        <%= message %>
      </div>
    <% end %>

    <% if flash.keys.size == 0 %>
      <p>スポンサー <%= @sponsor.name %> の担当者として登録します。</p>
      <% if @sponsor_contact.new_record? %>
        <p>登録する場合はフォームにスポンサー担当者情報を入力し、「登録する」ボタンをクリックしてください。</p>
      <% else %>
        <p>スポンサー担当者として既に登録済みのため、フォームに既存の情報が入力済みです。</p>
        <p>問題なければ「登録する」ボタンをクリックしてください。</p>
      <% end %>

      <%= form_with(url: sponsor_contact_invite_accepts_url, model: @sponsor_contact, method: :post) do |form| %>
        <%= form.hidden_field :sponsor_contact_invite_id, value: @sponsor_contact_invite.id %>

        <section class="tw-py-3">
          <div class="tw-mb-4">
            <%= form.label :name, class: 'dk-label' do %>
              担当者氏名<span class="dk-required">*</span>
            <% end %>
            <%= form.text_field :name, class: "dk-input", required: true, placeholder: 'クラウド 太郎' %>
          </div>
        </section>

        <div class="tw-py-3 tw-text-center">
          <%= form.submit class: "dk-btn-primary tw-w-full tw-py-3 tw-text-lg" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
