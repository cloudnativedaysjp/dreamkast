<%= form_with(model: sponsor_contact_invite, local: true) do |f| %>
  <% if sponsor_contact_invite.errors.any? %>
    <div class="dk-alert dk-alert-danger">
      <ul>
        <% sponsor_contact_invite.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="tw-mb-4">
    <%= f.label :email, class: "dk-label" %>
    <%= f.email_field :email, class: "dk-input" %>
  </div>

  <%= f.hidden_field :sponsor_id %>

  <div class="tw-flex tw-justify-end tw-gap-2">
    <%= f.submit "Send Invitation", class: "dk-btn-primary" %>
  </div>
<% end %>
