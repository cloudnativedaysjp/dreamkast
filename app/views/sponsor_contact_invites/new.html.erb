<%= render "layouts/modal", title: "登録" do %>
  <% flash.each do |key, value| %>
    <div class="dk-alert dk-alert-danger" role="alert"><%= flash[:alert] %></div>
  <% end %>
  <h1 class="entry tw-mb-4 tw-text-center tw-text-xl tw-font-semibold">スポンサー担当者に招待メールを送信する</h1>
  <%= form_with(model: @sponsor_contact_invite, data: { action: "turbo:submit-end->modal#close" }) do |form| %>
    <div class="tw-mb-4">
      <%= form.label :email, class: 'dk-label' %>
      <%= form.email_field :email, class: "dk-input", required: true %>
    </div>
    <%= form.hidden_field :sponsor_id, value: @sponsor.id %>
    <div>
      <%= form.submit "招待メールを送信する", class: "dk-btn-primary tw-w-full", data: { turbo_confirm: '本当に公開しますか？' } %>
    </div>
  <% end %>
<% end %>
