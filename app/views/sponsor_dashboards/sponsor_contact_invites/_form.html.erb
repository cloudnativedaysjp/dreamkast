<%= form_with(model: [:sponsor_dashboards, sponsor_contact_invite],
              data: { action: "turbo:submit-end->modal#close" }) do |form| %>
  <div class="tw-mb-4">
    <%= form.label :email, class: 'dk-label' %>
    <%= form.email_field :email, class: "dk-input", required: true %>
  </div>
  <%= form.hidden_field :sponsor_id, value: sponsor.id %>
  <div>
    <%= form.submit "招待メールを送信する", class: "dk-btn-primary tw-w-full", data: { turbo_confirm: '本当に招待しますか？' } %>
  </div>
<% end %>
