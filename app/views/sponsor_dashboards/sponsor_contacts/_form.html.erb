<div class="tw-mx-auto tw-w-full tw-max-w-2xl speaker-dashboard-form">
  <h1 class="entry tw-mb-6 tw-py-3 tw-text-center tw-text-2xl tw-font-semibold">スポンサー担当者情報フォーム(<%= @sponsor.name %>)</h1>
  <%= form_with(url: sponsor_url, model: @sponsor_contact) do |form| %>
    <section class="speaker-information tw-py-3">
      <h3 class="tw-mb-4 tw-text-lg tw-font-semibold">スポンサー担当者情報</h3>

      <div class="tw-mb-4">
        <%= form.label :name, class: 'dk-label' do %>
          名前<span class="dk-required">*</span>
        <% end %>
        <%= form.text_field :name, class: "dk-input", required: true, placeholder: 'クラウド 太郎' %>
      </div>
    </section>
    <div class="tw-py-3 tw-text-center">
      <%= form.submit class: "dk-btn-primary tw-w-full tw-py-3 tw-text-lg" %>
    </div>
  <% end %>
</div>
