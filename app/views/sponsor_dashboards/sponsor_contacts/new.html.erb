<div class="dk-container speaker-dashboard-form tw-py-4">
  <% if logged_in? %>
    <%= render 'form', sponsor: @sponsor_contact %>
  <% else %>
    <div class="tw-my-4 tw-text-center">
      <%= button_to 'スポンサーダッシュボードにログインする', '/auth/auth0', {method: :post, class: "dk-btn-secondary tw-px-6 tw-py-3" } %>
    </div>
  <% end %>
</div>
