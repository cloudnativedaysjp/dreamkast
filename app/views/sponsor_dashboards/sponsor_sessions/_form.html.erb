<%= form_with(model: [:sponsor_dashboards, sponsor_session],
              url: sponsor_session.new_record? ? sponsor_dashboards_sponsor_sessions_path(event: params[:event], sponsor_id: params[:sponsor_id]) : sponsor_dashboards_sponsor_session_path(sponsor_session, event: params[:event], sponsor_id: params[:sponsor_id]),
              data: { action: "turbo:submit-end->modal#close" }) do |f| %>
  <% if f.object.errors.any? %>
    <div id="error_explanation" class="dk-alert dk-alert-danger" role="alert">
      <h5 class="tw-mb-2 tw-font-semibold">入力内容にエラーがあります:</h5>
      <ul>
        <% f.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="talk-field">
    <div class="tw-mb-4">
      <%= f.label :title, class: 'dk-label' do %>
        講演タイトル - Abstract Title（★★★）<span class="dk-required">*</span>
      <% end %>
      <p class="dk-hint">（最大50文字）受講者の目を引くようなるべく具体的なテクノロジー名を含めることをおすすめします - (Maximum 100 characters) Include concrete technology names as possible to attract attendees</p>
      <%= f.text_field :title, class: "dk-input", required: true %>
    </div>
    <div class="tw-mb-4">
      <%= f.label :abstract, '講演内容 - Abstract（★★★）', class: 'dk-label' %>
      <p class="dk-hint">（200文字程度）どんな人に向けた講演かこの講演によって受講者がどんな情報を得られるかを含めることをおすすめします - (About 400 letters) Include a session for what kind of person, what kind of information the attendee can get</p>
      <%= f.text_area :abstract, {class: "dk-textarea abstract"}  %>
    </div>
    <% unless conference.id == 15 %>
      <div class="tw-mb-4">
        <%= f.label :talk_category_id, class: 'dk-label' do %>
          主なカテゴリ - Main Category（★★）<span class="dk-required">*</span>
        <% end %>
        <p class="dk-hint">必ずしもCNCFのプロジェクトに関する内容でなくても問題ありません - It does not necessarily have to be content of the CNCF project</p>
        <%= f.collection_select :talk_category_id, conference.talk_categories, :id, :name, {prompt: ""}, class: "dk-select talk-categories", required: true %>
      </div>
    <% end %>
    <div class="tw-mb-4">
      <%= f.label :talk_difficulty_id, class: 'dk-label' do %>
        受講者レベル - Audience Experience Level（★★）<span class="dk-required">*</span>
      <% end %>
      <%= f.collection_select :talk_difficulty_id, conference.talk_difficulties, :id, :name, {prompt: ""}, class: "dk-select", required: true %>
    </div>
    <div class="tw-mb-4">
      <%= f.label :speaker_ids, "スポンサー登壇者", class: 'dk-label' %>
      <p class="dk-hint">複数選択可能です。選択しなくても登録・更新できます。</p>
      <%= f.collection_select :speaker_ids, sponsor_speakers, :id, :name, {  include_blank: '選択を解除する', },{ multiple: true, class: "dk-select", style: "min-height: 100px;" } %>
    </div>
    <% if conference.speaker_entry_disabled? %>
      <div class="tw-mb-4">
        <%= f.label :document_url, "セッション資料公開URL", class: 'dk-label' %>
        <%= f.text_field :document_url, class: "dk-input" %>
      </div>
    <% end %>
    <% three_conf_labels = ['target_conferences', 'cnd_category', 'cnd_assumed_visitor', 'pek_category', 'pek_assumed_visitor', 'srek_category', 'srek_assumed_visitor'] %>
    <% conference.proposal_item_configs.map(&:item_number).uniq.each do |item_number| %>
      <% first_item = conference.proposal_item_configs.find_by(item_number: item_number) %>
      <% next unless first_item %>
      <% next if conference.id == 15 && three_conf_labels.include?(first_item.label) %>
      <div class="tw-mb-4">
        <% if first_item.class.to_s == 'ProposalItemConfigCheckBox' %>
          <%= render 'sponsor_dashboards/sponsor_sessions/proposal_item_config_check_box', f: f, first_item: first_item, item_number: item_number %>
        <% elsif first_item.class.to_s == 'ProposalItemConfigRadioButton' %>
          <%= render 'sponsor_dashboards/sponsor_sessions/proposal_item_config_radio_button', f: f, first_item: first_item, item_number: item_number %>
        <% end %>
      </div>
    <% end %>

    <% if conference.id == 15 %>
      <% form_index = 'sponsor_session' %>
      <% target_conf_configs = conference.proposal_item_configs.where(label: 'target_conferences') %>
      <% first_item = target_conf_configs.first %>
      <% existing_target_conferences = sponsor_session.proposal_items.find_by(label: 'target_conferences')&.params || [] %>

      <div class="tw-mb-4">
        <%= label_tag "sponsor_session_proposal_items_attributes_target_conferences", class: 'dk-label' do %>
          <%= first_item.item_name %><span class="dk-required">*</span>
        <% end %>
        <p class="dk-hint"><%= first_item.description&.html_safe %></p>

        <% cnd_config = target_conf_configs.find { |c| c.params == 'Cloud Native' } %>
        <% if cnd_config %>
          <% cnd_checked = existing_target_conferences.include?(cnd_config.id.to_s) %>
          <div class="cfp-conference-card tw-mb-3 tw-rounded-md tw-border tw-p-3 <%= 'tw-border-blue-500 tw-bg-blue-50' if cnd_checked %>">
            <div class="tw-flex tw-items-start">
              <%= check_box_tag "sponsor_session[proposal_items_attributes][target_conferences][]",
                                cnd_config.id,
                                cnd_checked,
                                {
                                  id: "target_conference_cloud_native_#{form_index}",
                                  class: 'dk-checkbox target-conference-checkbox',
                                  data: { conference_type: 'cloud-native', form_index: form_index }
                                } %>
              <%= label_tag "target_conference_cloud_native_#{form_index}", cnd_config.params, {class: 'dk-check-label'} %>
            </div>

            <div class="cnd-fields tw-mt-3 tw-pl-4" data-form-index="<%= form_index %>" style="<%= 'display: none;' unless cnd_checked %>">
              <% cnd_category_configs = conference.proposal_item_configs.where(label: 'cnd_category') %>
              <% cnd_category_first = cnd_category_configs.first %>
              <% cnd_existing_category = sponsor_session.proposal_items.find_by(label: 'cnd_category')&.params %>

              <div class="tw-mb-3">
                <%= label_tag "sponsor_session_proposal_items_attributes_cnd_categories", class: 'dk-label' do %>
                  <%= cnd_category_first.item_name %><span class="dk-required">*</span>
                <% end %>
                <%= select_tag "sponsor_session[proposal_items_attributes][cnd_categories]",
                              options_for_select([['選択してください', '']] + cnd_category_configs.map { |item| [item.params, item.id] }, cnd_existing_category),
                              { class: 'dk-select cnd-category-select' } %>
              </div>

              <% cnd_visitor_configs = conference.proposal_item_configs.where(label: 'cnd_assumed_visitor') %>
              <% cnd_visitor_first = cnd_visitor_configs.first %>
              <% cnd_existing_visitors = sponsor_session.proposal_items.find_by(label: 'cnd_assumed_visitor')&.params || [] %>

              <div class="tw-mb-2">
                <%= label_tag "sponsor_session_proposal_items_attributes_cnd_assumed_visitors", class: 'dk-label' do %>
                  <%= cnd_visitor_first.item_name %><span class="dk-required">*</span>
                <% end %>
              </div>
              <div class="tw-space-y-1">
                <% cnd_visitor_configs.each do |item| %>
                  <% checked = cnd_existing_visitors.include?(item.id.to_s) %>
                  <div class="tw-flex tw-items-center">
                    <%= check_box_tag "sponsor_session[proposal_items_attributes][cnd_assumed_visitors][]", item.id, checked, {class: 'dk-checkbox cnd-visitor-checkbox', id: "cnd_assumed_visitor_#{item.id}_#{form_index}"} %>
                    <%= label_tag "cnd_assumed_visitor_#{item.id}_#{form_index}", item.params, {class: 'dk-check-label'} %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% pek_config = target_conf_configs.find { |c| c.params == 'Platform Engineering' } %>
        <% if pek_config %>
          <% pek_checked = existing_target_conferences.include?(pek_config.id.to_s) %>
          <div class="cfp-conference-card tw-mb-3 tw-rounded-md tw-border tw-p-3 <%= 'tw-border-blue-500 tw-bg-blue-50' if pek_checked %>">
            <div class="tw-flex tw-items-start">
              <%= check_box_tag "sponsor_session[proposal_items_attributes][target_conferences][]",
                                pek_config.id,
                                pek_checked,
                                {
                                  id: "target_conference_platform_engineering_#{form_index}",
                                  class: 'dk-checkbox target-conference-checkbox',
                                  data: { conference_type: 'platform-engineering', form_index: form_index }
                                } %>
              <%= label_tag "target_conference_platform_engineering_#{form_index}", pek_config.params, {class: 'dk-check-label'} %>
            </div>

            <div class="pek-fields tw-mt-3 tw-pl-4" data-form-index="<%= form_index %>" style="<%= 'display: none;' unless pek_checked %>">
              <% pek_category_configs = conference.proposal_item_configs.where(label: 'pek_category') %>
              <% pek_category_first = pek_category_configs.first %>
              <% pek_existing_category = sponsor_session.proposal_items.find_by(label: 'pek_category')&.params %>

              <div class="tw-mb-3">
                <%= label_tag "sponsor_session_proposal_items_attributes_pek_categories", class: 'dk-label' do %>
                  <%= pek_category_first.item_name %><span class="dk-required">*</span>
                <% end %>
                <%= select_tag "sponsor_session[proposal_items_attributes][pek_categories]",
                              options_for_select([['選択してください', '']] + pek_category_configs.map { |item| [item.params, item.id] }, pek_existing_category),
                              { class: 'dk-select pek-category-select' } %>
              </div>

              <% pek_visitor_configs = conference.proposal_item_configs.where(label: 'pek_assumed_visitor') %>
              <% pek_visitor_first = pek_visitor_configs.first %>
              <% pek_existing_visitors = sponsor_session.proposal_items.find_by(label: 'pek_assumed_visitor')&.params || [] %>

              <div class="tw-mb-2">
                <%= label_tag "sponsor_session_proposal_items_attributes_pek_assumed_visitors", class: 'dk-label' do %>
                  <%= pek_visitor_first.item_name %><span class="dk-required">*</span>
                <% end %>
              </div>
              <div class="tw-space-y-1">
                <% pek_visitor_configs.each do |item| %>
                  <% checked = pek_existing_visitors.include?(item.id.to_s) %>
                  <div class="tw-flex tw-items-center">
                    <%= check_box_tag "sponsor_session[proposal_items_attributes][pek_assumed_visitors][]", item.id, checked, {class: 'dk-checkbox pek-visitor-checkbox', id: "pek_assumed_visitor_#{item.id}_#{form_index}"} %>
                    <%= label_tag "pek_assumed_visitor_#{item.id}_#{form_index}", item.params, {class: 'dk-check-label'} %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% srek_config = target_conf_configs.find { |c| c.params == 'SRE' } %>
        <% if srek_config %>
          <% srek_checked = existing_target_conferences.include?(srek_config.id.to_s) %>
          <div class="cfp-conference-card tw-mb-3 tw-rounded-md tw-border tw-p-3 <%= 'tw-border-blue-500 tw-bg-blue-50' if srek_checked %>">
            <div class="tw-flex tw-items-start">
              <%= check_box_tag "sponsor_session[proposal_items_attributes][target_conferences][]",
                                srek_config.id,
                                srek_checked,
                                {
                                  id: "target_conference_sre_#{form_index}",
                                  class: 'dk-checkbox target-conference-checkbox',
                                  data: { conference_type: 'sre', form_index: form_index }
                                } %>
              <%= label_tag "target_conference_sre_#{form_index}", srek_config.params, {class: 'dk-check-label'} %>
            </div>

            <div class="srek-fields tw-mt-3 tw-pl-4" data-form-index="<%= form_index %>" style="<%= 'display: none;' unless srek_checked %>">
              <% srek_category_configs = conference.proposal_item_configs.where(label: 'srek_category') %>
              <% srek_category_first = srek_category_configs.first %>
              <% srek_existing_category = sponsor_session.proposal_items.find_by(label: 'srek_category')&.params %>

              <div class="tw-mb-3">
                <%= label_tag "sponsor_session_proposal_items_attributes_srek_categories", class: 'dk-label' do %>
                  <%= srek_category_first.item_name %><span class="dk-required">*</span>
                <% end %>
                <%= select_tag "sponsor_session[proposal_items_attributes][srek_categories]",
                              options_for_select([['選択してください', '']] + srek_category_configs.map { |item| [item.params, item.id] }, srek_existing_category),
                              { class: 'dk-select srek-category-select' } %>
              </div>

              <% srek_visitor_configs = conference.proposal_item_configs.where(label: 'srek_assumed_visitor') %>
              <% srek_visitor_first = srek_visitor_configs.first %>
              <% srek_existing_visitors = sponsor_session.proposal_items.find_by(label: 'srek_assumed_visitor')&.params || [] %>

              <div class="tw-mb-2">
                <%= label_tag "sponsor_session_proposal_items_attributes_srek_assumed_visitors", class: 'dk-label' do %>
                  <%= srek_visitor_first.item_name %><span class="dk-required">*</span>
                <% end %>
              </div>
              <div class="tw-space-y-1">
                <% srek_visitor_configs.each do |item| %>
                  <% checked = srek_existing_visitors.include?(item.id.to_s) %>
                  <div class="tw-flex tw-items-center">
                    <%= check_box_tag "sponsor_session[proposal_items_attributes][srek_assumed_visitors][]", item.id, checked, {class: 'dk-checkbox srek-visitor-checkbox', id: "srek_assumed_visitor_#{item.id}_#{form_index}"} %>
                    <%= label_tag "srek_assumed_visitor_#{item.id}_#{form_index}", item.params, {class: 'dk-check-label'} %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= f.hidden_field :sponsor_id, value: sponsor.id %>
    <%= f.hidden_field :conference_id, value: conference.id %>
  </div>
  <div class="tw-mt-4">
    <% if sponsor_session.new_record? %>
      <%= f.submit "スポンサーセッションを登録する", class: "dk-btn-primary tw-w-full" %>
    <% else %>
      <%= f.submit "スポンサーセッションを更新する", class: "dk-btn-primary tw-w-full" %>
    <% end %>
  </div>
<% end %>
