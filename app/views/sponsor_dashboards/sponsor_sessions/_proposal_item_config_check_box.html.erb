<% existing_items = f.object.persisted? ? f.object.proposal_items.find_by(label: first_item.label)&.params : []%>
<%= label_tag "sponsor_session[proposal_items_attributes][#{first_item.label}]",  first_item.item_name, {class: 'dk-label'}%><span class="dk-required">*</span>
<div class="tw-mt-2 tw-space-y-2">
  <% @conference.proposal_item_configs.where(item_number: item_number).each do |item|%>
    <% label = item.label.pluralize.to_sym %>
    <% checked = existing_items ? existing_items.include?(item.id.to_s) : false%>
    <div class="tw-flex tw-items-center">
      <%= check_box_tag "sponsor_session[proposal_items_attributes][#{label}][]", item.id, checked, {class: 'dk-checkbox', id: "#{label}_#{item.params}"} %>
      <%= label label, item.params, {class: 'dk-check-label'} %>
    </div>
  <% end %>
</div>
