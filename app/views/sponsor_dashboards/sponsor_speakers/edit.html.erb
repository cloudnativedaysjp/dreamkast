<%= render "layouts/modal", title: "スポンサー登壇者を編集する" do %>
  <h1 class="entry tw-mb-4 tw-text-center tw-text-xl tw-font-semibold">編集フォーム(スポンサー用)</h1>
  <div class="tw-mb-4 tw-text-sm tw-text-gray-600">
    ※ ログインに使っているメールアドレスが同じ場合、スポンサーセッションと公募セッションの登壇者プロフィールは同一となります<br>
    ※ スポンサーセッション、公募セッション両方が表示されます
  </div>
  <%= form_with(url: sponsor_dashboards_sponsor_speaker_path(sponsor_id: @sponsor.id, id: @speaker.id),
                model: @speaker,
                method: :patch,
                data: { action: "turbo:submit-end->modal#close" }) do |form| %>
    <%= render 'speaker_dashboard/speakers/form_speaker', form: form %>
    <div class="tw-py-3 tw-text-center">
      <%= form.submit "更新する", class: "dk-btn-primary tw-w-full tw-py-3 tw-text-lg" %>
    </div>
  <% end %>
<% end %>
