<% provide(:title, 'スタンプラリーチェックイン記録') %>
<% flash.each do |_message_type, message| %>
  <div class="tw-fixed tw-inset-0 tw-z-50 tw-flex tw-items-center tw-justify-center tw-bg-black/40 tw-p-4" data-controller="modal">
    <div class="tw-w-full tw-max-w-lg tw-rounded-lg tw-bg-white tw-shadow-lg">
      <div class="tw-flex tw-items-center tw-justify-between tw-border-b tw-border-gray-200 tw-px-5 tw-py-3">
        <h5 class="tw-m-0 tw-text-lg tw-font-semibold">チェックインしました🎉</h5>
        <button type="button" class="tw-rounded tw-p-1 tw-text-gray-500 hover:tw-bg-gray-100" data-action="modal#dismiss" aria-label="Close">×</button>
      </div>
      <div class="tw-px-5 tw-py-4">
        <%= message %>
      </div>
      <div class="tw-flex tw-justify-end tw-border-t tw-border-gray-200 tw-px-5 tw-py-3">
        <button type="button" class="dk-btn-secondary" data-action="modal#dismiss">Close</button>
      </div>
    </div>
  </div>
<% end %>

<div class="dk-container white_background tw-mt-3">
  <h1 class="tw-my-3 tw-text-center tw-text-3xl tw-font-semibold">スタンプラリーCP一覧</h1>

  <% case stamp_rally_status %>
  <% when :not %>
    <p>スタンプラリーはまだ開始されていません。</p>
  <% when :in_progress %>
    <p>まだ回っていないCPがあります</p>
  <% when :pre_finished %>
    <p>ゴール条件を満たしました！受付でゴールしてください</p>
  <% when :finished %>
    <p>ゴール！！！</p>
  <% else raise "Invalid status" %>
  <% end %>
  <div class="tw-grid tw-grid-cols-2 tw-gap-2 sm:tw-grid-cols-3 md:tw-grid-cols-5">

    <% @stamp_rally_check_points.each_with_index do |check_point, index| %>
      <%= render "check_point", index: index, stamp_rally_check_ins: @stamp_rally_check_ins, check_point: check_point %>
    <% end %>

    <% @stamp_rally_check_point_finishes.each_with_index do |check_point, index| %>
      <%= render "check_point", index: index, stamp_rally_check_ins: @stamp_rally_check_ins, check_point: check_point %>
    <% end %>
  </div>
</div>
