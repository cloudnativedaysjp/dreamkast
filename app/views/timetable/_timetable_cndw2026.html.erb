<%
  tracks = conference.tracks.order(:number)
  conference_days = conference.conference_days.externals.order(:date)
  attend_offline = @profile.respond_to?(:attend_offline?) && @profile.attend_offline?
%>

<div class="tw-bg-slate-50 tw-pb-16 tw-pt-8 <%= 'tw-pb-40' if form %>">
  <div class="tw-mx-auto tw-w-full tw-max-w-screen-2xl tw-px-4">
    <h1 class="tw-mb-4 tw-text-center tw-text-3xl tw-font-bold tw-tracking-wide tw-text-gray-900">タイムテーブル</h1>

    <% if conference_days.size > 1 %>
      <nav class="tw-mb-8 tw-flex tw-flex-wrap tw-justify-center tw-gap-2" aria-label="開催日">
        <% conference_days.each_with_index do |conference_day, day_index| %>
          <a href="#timetable-day-<%= day_index + 1 %>"
             class="tw-rounded-full tw-border tw-border-solid tw-border-cndt-navy tw-bg-white tw-px-4 tw-py-1.5 tw-text-sm tw-font-semibold tw-text-cndt-navy tw-no-underline tw-transition hover:tw-bg-cndt-navy hover:tw-text-white hover:tw-no-underline">
            Day <%= day_index + 1 %> <span class="tw-font-normal"><%= l(conference_day.date, format: '%-m/%-d(%a)') %></span>
          </a>
        <% end %>
      </nav>
    <% end %>

    <% conference_days.each_with_index do |conference_day, day_index| %>
      <%
        talks = conference_day.talks
                              .where(show_on_timetable: true)
                              .includes(:track, :talk_category, :sponsor, :speakers)
        grid = timetable_grid(conference_day, tracks, talks)
      %>
      <section id="timetable-day-<%= day_index + 1 %>" class="tw-mb-12 tw-scroll-mt-20">
        <h2 class="tw-mb-4 tw-flex tw-items-baseline tw-gap-3 tw-border-0 tw-border-b-2 tw-border-solid tw-border-cndt-magenta tw-pb-2 tw-text-xl tw-font-bold tw-text-gray-900">
          <span class="tw-text-cndt-magenta">Day <%= day_index + 1 %></span>
          <span><%= l(conference_day.date, format: '%Y年%-m月%-d日(%a)') %></span>
        </h2>

        <% if grid.talks.empty? %>
          <p class="tw-py-8 tw-text-center tw-text-gray-500">セッション情報は準備中です。</p>
        <% else %>
          <%# トラック見出し: グリッドの外に置いてスクロールに追従させる %>
          <div class="tw-sticky tw-top-14 tw-z-20 tw-hidden tw-gap-x-2 tw-bg-slate-50/95 tw-py-2 tw-backdrop-blur lg:tw-grid"
               style="<%= timetable_grid_columns_style(grid) %>">
            <div></div>
            <% grid.tracks.each do |track| %>
              <div class="tw-rounded-md tw-border-0 tw-border-t-4 tw-border-solid <%= grid.track_accent(track)[:header] %> tw-bg-white tw-py-2 tw-text-center tw-text-sm tw-font-bold tw-text-gray-800 tw-shadow-sm">
                Track <%= track.name %>
              </div>
            <% end %>
          </div>

          <div class="tw-relative tw-block tw-gap-x-2 lg:tw-grid"
               style="<%= timetable_grid_columns_style(grid) %> grid-template-rows: repeat(<%= grid.total_rows %>, 3px);">
            <% grid.tracks.each do |track| %>
              <div class="tw-hidden tw-rounded-md tw-bg-white/60 lg:tw-block"
                   style="grid-column: <%= grid.track_column(track) %>; grid-row: 1 / -1;"></div>
            <% end %>

            <% grid.talks_by_start_time.each_with_index do |(start_time, talks_at_time), time_index| %>
              <% row = grid.row_start(start_time) %>
              <div class="tw-hidden tw-border-0 tw-border-t tw-border-dashed tw-border-gray-300 lg:tw-block"
                   style="grid-column: 2 / -1; grid-row: <%= row %>;"></div>
              <div class="tw-mb-2 <%= 'tw-mt-6' unless time_index.zero? %> tw-text-sm tw-font-bold tw-text-gray-700 lg:tw-m-0 lg:tw-pr-2 lg:tw-text-right lg:tw-text-xs lg:tw-font-semibold lg:tw-leading-none lg:tw-text-gray-500"
                   style="grid-column: 1; grid-row: <%= row %>;">
                <%= start_time.strftime('%H:%M') %>
              </div>

              <% talks_at_time.each do |talk| %>
                <%
                  row_start, row_end = grid.talk_rows(talk)
                  accent = grid.talk_accent(talk)
                  sold_out = attend_offline && talk.sold_out?
                %>
                <div class="tw-relative tw-mb-2 tw-min-w-0 hover:tw-z-10 lg:tw-mb-0 lg:tw-py-0.5"
                     slot="<%= talk.slot_number %>"
                     style="grid-column: <%= grid.talk_column(talk) %>; grid-row: <%= row_start %> / <%= row_end %>;">
                  <% if form %>
                  <label class="tw-group tw-m-0 tw-block tw-cursor-pointer has-[:disabled]:tw-cursor-not-allowed lg:tw-h-full">
                    <%= form.check_box "talks[#{talk.id}]",
                                       {
                                         talk_id: talk.id,
                                         day_slot: talk.day_slot,
                                         talk_number: talk.talk_number,
                                         checked: talks_checked?(talk.id),
                                         class: "talks_checkbox slot_#{talk.day_slot} #{talk.talk_number} tw-sr-only",
                                         disabled: sold_out,
                                         "data-conference-day": conference_day.id,
                                         "data-start-time": talk.start_time.to_i,
                                         "data-end-time": talk.end_time.to_i
                                       },
                                       true,
                                       false %>
                  <% end %>
                  <div class="tw-flex tw-flex-col tw-gap-1 tw-overflow-hidden tw-rounded-md tw-border tw-border-l-4 tw-border-solid tw-border-gray-200 <%= accent[:card] %> tw-bg-white tw-p-2 tw-shadow-sm tw-transition hover:tw-shadow-md group-has-[:checked]:tw-bg-sky-50 group-has-[:checked]:tw-ring-2 group-has-[:checked]:tw-ring-cndt-navy group-has-[:focus-visible]:tw-outline group-has-[:focus-visible]:tw-outline-2 group-has-[:focus-visible]:tw-outline-offset-2 group-has-[:focus-visible]:tw-outline-blue-500 group-has-[:disabled]:tw-opacity-50 lg:tw-h-full lg:hover:tw-h-auto lg:hover:tw-min-h-full lg:hover:tw-overflow-visible"
                       talk_id="<%= talk.id %>"
                       track_number="<%= talk.track.number %>">
                    <div class="tw-flex tw-items-start tw-justify-between tw-gap-2">
                      <p class="tw-m-0 tw-text-xs tw-leading-tight tw-text-gray-500">
                        <span class="tw-mr-1 tw-font-bold <%= accent[:text] %> lg:tw-hidden">Track <%= talk.track.name %></span>
                        <%= talk.start_time.strftime('%H:%M') %>-<%= talk.end_time.strftime('%H:%M') %>
                        <% if attend_offline %>
                          <span class="tw-ml-1 tw-font-semibold tw-text-gray-700"><%= talk.seats_status %></span>
                        <% end %>
                      </p>
                      <% if form %>
                        <span class="tw-flex tw-h-4 tw-w-4 tw-shrink-0 tw-items-center tw-justify-center tw-rounded-full tw-border-2 tw-border-solid tw-border-gray-300 tw-bg-white tw-text-white group-has-[:checked]:tw-border-cndt-navy group-has-[:checked]:tw-bg-cndt-navy" aria-hidden="true">
                          <svg class="tw-hidden tw-h-2.5 tw-w-2.5 group-has-[:checked]:tw-block" viewBox="0 0 16 16" fill="none">
                            <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      <% end %>
                    </div>

                    <h3 class="tw-m-0 tw-break-words tw-text-sm tw-font-bold tw-leading-snug">
                      <%= link_to talk.title, talk_path(id: talk.id),
                                  class: 'tw-text-gray-900 tw-no-underline hover:tw-text-cndt-magenta hover:tw-underline',
                                  "data-talk-modal": true %>
                    </h3>

                    <% if talk.speakers.present? %>
                      <p class="tw-m-0 tw-text-xs tw-leading-tight tw-text-gray-600"><%= talk.speakers.map(&:name).join(' / ') %></p>
                    <% end %>

                    <% if talk.talk_category.present? || talk.sponsor.present? %>
                      <div class="tw-flex tw-flex-wrap tw-gap-1">
                        <% if talk.talk_category.present? %>
                          <span class="tw-rounded-full tw-bg-gray-100 tw-px-2 tw-py-0.5 tw-text-[0.65rem] tw-leading-tight tw-text-gray-600"><%= talk.talk_category.name %></span>
                        <% end %>
                        <% if talk.sponsor.present? %>
                          <span class="tw-rounded-full tw-bg-amber-100 tw-px-2 tw-py-0.5 tw-text-[0.65rem] tw-leading-tight tw-text-amber-800">スポンサーセッション</span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <% if form %>
                  </label>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

<% if form %>
  <div class="tw-fixed tw-inset-x-0 tw-bottom-0 tw-z-40 tw-border-0 tw-border-t tw-border-solid tw-border-gray-200 tw-bg-white/95 tw-shadow-[0_-4px_12px_rgba(0,0,0,0.08)] tw-backdrop-blur">
    <div class="tw-mx-auto tw-flex tw-max-w-screen-lg tw-flex-col tw-items-center tw-gap-3 tw-px-4 tw-py-3 md:tw-flex-row md:tw-justify-between">
      <p class="tw-m-0 tw-text-center tw-text-xs tw-text-gray-600 md:tw-text-left">
        視聴したいセッションを選択してください。セッション名をクリックすると詳細が表示されます。
      </p>
      <%= form.submit 'セッション登録', class: 'dk-btn-primary tw-w-full tw-shrink-0 tw-px-8 tw-py-2.5 tw-text-base md:tw-w-auto' %>
    </div>
  </div>
<% end %>
<%= hidden_field_tag('is_offline', attend_offline) %>
