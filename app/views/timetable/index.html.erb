<% provide(:title, 'タイムテーブル') %>

<div id="talk-modal" class="tw-hidden"></div>

<% if current_user %>
  <%= form_with url: profiles_talks_path(event: @conference.abbr), method: :post do |form| %>
    <%= render partial: timetable_partial_name, locals: {conference: @conference, form: form} %>
  <% end %>
<% else %>
  <%= render partial: timetable_partial_name, locals: {conference: @conference, form: nil} %>
<% end %>
